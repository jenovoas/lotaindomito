# ============================================================
# Lota Indómito — gitignore raíz
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.egg-info/

# --- Node / JS / build artifacts ---
node_modules/
.next/
.nuxt/
out/
dist/
build/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo
.npm/
.yarn/

# --- Piloto A (Vue 3 + MapLibre) ---
piloto-a/dist/
piloto-a/node_modules/
piloto-a/.vite/

# --- Rust / Cargo build artifacts ---
target/
**/target/
*.rustc_info.json
Cargo.lock.bak

# --- Secrets / keys (NUNCA commitear) ---
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
secrets/
.secrets/
config.local.yaml
config.local.json
credentials.json
service-account*.json

# --- IDEs / editores ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Claude / agentes ---
.claude/
.aider*
.opencode/

# --- Hermes (agent local state) ---
.hermes/

# --- Tooling local (indexadores, run-continuation) ---
.omo/
.omo/run-continuation/
.codegraph/
*.codegraph

# --- Logs / runtime ---
*.log
*.pid
*.sock
.cache/

# --- Audio/video pesado (audios del cliente en otro lado) ---
*.ogg
*.opus
*.mp3
*.wav
*.m4a
*.mp4
*.webm
*.mov

# --- Stitch: el prototipo se sirve desde el fan (no gitignored, va al repo) ---
# stitch_lota_ind_mito_ciudad_museo_gamificada/

# --- rclone bisync internals ---
*.lst
*.lst-new

# --- WhatsApp (audios originales del cliente, pesados) ---
whatsapp/
_cliente_fabiola_original/

# --- OS ---
.Trash-*
.nfs*

# HTML generados por docs/_render/render-docs.py (se regeneran en el fan)
docs/*.html
_analisis/*.html
README.html

# Conflictos de merge huérfanos (resolver y limpiar antes de commit)
*.conflict1
*.conflict2
*.conflict3
*.orig
*.rej
